# PostgreSQL connection string — required (this app uses PostgreSQL only)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/xlri_bidding"

# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-min-32-chars"

# The base URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
